{
  "name": "my-app",
  "description": "Nour Group ERP desktop and installable web app with optional Supabase sync",
  "author": "Nour Group",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:web": "node deploy-web.js"
  },
  "build": {
    "appId": "com.nourgroup.erbdemo",
    "productName": "Nour Group ERP",
    "directories": {
      "output": "offline-release"
    },
    "win": {
      "artifactName": "Nour Group ERP Setup ${version}.${ext}",
      "target": [
        "nsis"
      ],
      "icon": "images/nour.logo.ico"
    },
    "files": [
      "**/*",
      "!.git",
      "!release/**",
      "!dist-audio/**",
      "!offline-release/**",
      "!win-unpacked/**",
      "!.venv/**",
      "!dist/**",
      "!web-release/**",
      "!**/.env",
      "!node_modules/*",
      "node_modules/electron/**/*"
    ]
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "bwip-js": "^4.11.4",
    "exceljs": "^4.4.0",
    "nodemailer": "^6.9.14",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  }
}
